# Auth (required)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Database (PostgreSQL — required for Vercel; use Neon free tier)
# https://neon.tech — copy the pooled connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Email — pick ONE option (restart dev server after changing)

# Option A: Resend with your verified domain (production)
EMAIL_PROVIDER=resend
AUTH_RESEND_KEY=re_xxx
EMAIL_FROM="YAP <noreply@yap.college>"

# Option B: SMTP fallback for local dev (set EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM="YAP <you@gmail.com>"

# Stripe (optional — nightlife ticket checkout)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Admin dashboard (required to access /admin)
# Comma-separated @exeter.ac.uk addresses that get admin access at /admin.
ADMIN_EMAILS=you@exeter.ac.uk

# File uploads (required — post/listing images & video)
# Create a Blob store in the Vercel dashboard (Storage tab) and copy its token,
# or run `vercel blob store add` with the Vercel CLI. Without this, /api/upload
# will reject uploads with a 500.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
